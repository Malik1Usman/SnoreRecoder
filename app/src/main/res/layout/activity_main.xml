<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#0D1117">

    <TextView
        android:text="🎙️ Snore Analyzer"
        android:textSize="26sp"
        android:textColor="#58A6FF"
        android:textStyle="bold"
        android:layout_marginBottom="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- Waveform / Status Indicator -->
    <TextView
        android:id="@+id/tvStatus"
        android:text="Tap Record to Start"
        android:textSize="16sp"
        android:textColor="#8B949E"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"/>

    <!-- Record Button -->
    <Button
        android:id="@+id/btnRecord"
        android:text="⏺ Start Recording"
        android:backgroundTint="#238636"
        android:textColor="#FFFFFF"
        android:layout_width="200dp"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"/>

    <!-- Stop Button -->
    <Button
        android:id="@+id/btnStop"
        android:text="⏹ Stop &amp; Analyze"
        android:backgroundTint="#DA3633"
        android:textColor="#FFFFFF"
        android:enabled="false"
        android:layout_width="200dp"
        android:layout_height="56dp"
        android:layout_marginBottom="32dp"/>

    <!-- Results Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="#161B22"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:text="Detection Results"
                android:textColor="#58A6FF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tvCategory"
                android:text="Category: —"
                android:textColor="#E6EDF3"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tvConfidence"
                android:text="Confidence: —"
                android:textColor="#8B949E"
                android:textSize="14sp"
                android:layout_marginTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tvRawLabel"
                android:text="Raw label: —"
                android:textColor="#6E7681"
                android:textSize="12sp"
                android:layout_marginTop="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <!-- Live classification log -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/tvLog"
                    android:text=""
                    android:textColor="#8B949E"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </ScrollView>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>